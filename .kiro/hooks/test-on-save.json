{
  "version": "v1",
  "hooks": [
    {
      "name": "haunt-kit tests on save",
      "trigger": "FileSave",
      "matcher": "haunt-kit/(src|test)/.*\\.ts$",
      "action": {
        "type": "command",
        "command": "npm test --workspace haunt-kit --silent"
      },
      "timeout": 120,
      "enabled": true
    },
    {
      "name": "lure safety check",
      "trigger": "FileSave",
      "matcher": "houses/.*/rooms/.*",
      "action": {
        "type": "command",
        "command": "node scripts/check-lures.mjs"
      },
      "timeout": 30,
      "enabled": true
    }
  ]
}
